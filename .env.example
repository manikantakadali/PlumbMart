# PlumbMart Environment Configuration
PORT=5000

# Supabase PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.llcsnbixfqbjboricsqs.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.llcsnbixfqbjboricsqs.supabase.co:5432/postgres

# Database Parameters
DB_USER=postgres
DB_PASSWORD=[YOUR-PASSWORD]
DB_HOST=db.llcsnbixfqbjboricsqs.supabase.co
DB_PORT=5432
DB_NAME=postgres

# Real SMS OTP Gateway Configuration (Fast2SMS / Twilio / 2Factor / Generic)
OTP_PROVIDER_NAME=fast2sms
OTP_PROVIDER_API_KEY=[YOUR-FAST2SMS-OR-TWILIO-KEY]
OTP_PROVIDER_SENDER_ID=FSTSMS
OTP_PROVIDER_TEMPLATE_ID=
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=3

# Email OTP Service Configuration (Gmail App Password or SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_16_char_google_app_password

# Zoho Inventory OAuth 2.0 Integration
# Register at https://api-console.zoho.in (or https://api-console.zoho.com)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SCOPE=ZohoInventory.fullaccess.all
ZOHO_ORG_ID=your_zoho_organization_id

